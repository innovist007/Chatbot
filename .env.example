# =============================================================
# .env.example — copy to .env.local (dev) or .env.production (prod)
# =============================================================

# ── Google Cloud / Vertex AI ──────────────────────────────────
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=global
AGENT_ID=agent_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BILLING_PROJECT_ID=your-billing-project-id

# ── Server ────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000          # local: 8000 | production: 8080

# ── Google OAuth ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxx-xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# ── JWT ───────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# ── Domain restriction ────────────────────────────────────────
ALLOWED_EMAIL_DOMAIN=onestolabs.com

# ── Email OTP (Gmail App Password) ───────────────────────────
# Enable 2-Step Verification, then create an App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Innovist Analytics
SMTP_FROM_EMAIL=alerts@onestolabs.com
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Redis (OTP session store) ─────────────────────────────────
# local dev:   REDIS_HOST=localhost  (docker run -d -p 6379:6379 redis:alpine)
# production:  REDIS_HOST=<Memorystore private IP>  (accessible via VPC connector)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=       # leave empty for Memorystore (no auth, VPC-secured)

# ── AI summary cron ───────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
CRON_SECRET_KEY=your-cron-secret-key-here
# Cron expression is UTC. 10:00 AM IST = 04:30 UTC → "30 4 * * *"
# Change this to shift the generation time without redeploying.
SUMMARY_CRON_SCHEDULE=30 4 * * *

# Cache version — bump ONLY to deliberately bust all Redis keys.
# Keep this in sync across environments; must stay pinned in production.
CACHE_VERSION=v5
